# Sasta Milaga — static storefront.
# The previous WordPress rules returned HTTP 403 to crawlers; nothing here blocks a
# search engine, an AI answer engine, sitemaps or static XML files.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS everywhere
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Legacy WordPress entry points
  RewriteRule ^index\.php$ / [R=301,L]
  RewriteRule ^wp-admin/?$ / [R=301,L]
  RewriteRule ^wp-login\.php$ / [R=301,L]
  RewriteRule ^wp-json/.*$ / [R=301,L]
  RewriteRule ^wp-includes/.*$ / [R=301,L]
  RewriteRule ^wp-content/.*$ / [R=301,L]
  RewriteRule ^shop/?$ /categories/ [R=301,L]
  RewriteRule ^feed/?$ /sitemap.xml [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Powered-By
  <FilesMatch "\.(?:css|js|woff2?|png|jpe?g|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# Never expose build sources or notes
<FilesMatch "\.(?:py|md|sh|bak|sql|log)$">
  Require all denied
</FilesMatch>
